        "\n",
        "import json\n",
        "import os\n",
        "import random\n",
        "\n",
        "FILE_NAME = \"parcels.json\"\n",
        "\n",
        "\n",
        "def load_parcels():\n",
        "    if os.path.exists(FILE_NAME):\n",
        "        with open(FILE_NAME, \"r\") as file:\n",
        "            return json.load(file)\n",
        "    return {}\n",
        "\n",
        "\n",
        "def save_parcels():\n",
        "    with open(FILE_NAME, \"w\") as file:\n",
        "        json.dump(parcels, file, indent=4)\n",
        "\n",
        "\n",
        "def book_parcel():\n",
        "    tracking_id = str(random.randint(100000, 999999))\n",
        "\n",
        "    while tracking_id in parcels:\n",
        "        tracking_id = str(random.randint(100000, 999999))\n",
        "\n",
        "    sender = input(\"Enter sender name: \")\n",
        "    receiver = input(\"Enter receiver name: \")\n",
        "    source = input(\"Enter source city: \")\n",
        "    destination = input(\"Enter destination city: \")\n",
        "\n",
        "    parcel = {\n",
        "        \"sender\": sender,\n",
        "        \"receiver\": receiver,\n",
        "        \"source\": source,\n",
        "        \"destination\": destination,\n",
        "        \"status\": \"Booked\"\n",
        "    }\n",
        "\n",
        "    parcels[tracking_id] = parcel\n",
        "    save_parcels()\n",
        "\n",
        "    print(\"\\nParcel booked successfully!\")\n",
        "    print(\"Your Tracking ID:\", tracking_id)\n",
        "\n",
        "\n",
        "def track_parcel():\n",
        "    tracking_id = input(\"Enter Tracking ID: \")\n",
        "\n",
        "    if tracking_id in parcels:\n",
        "        parcel = parcels[tracking_id]\n",
        "\n",
        "        print(\"\\n----- PARCEL DETAILS -----\")\n",
        "        print(\"Tracking ID:\", tracking_id)\n",
        "        print(\"Sender:\", parcel[\"sender\"])\n",
        "        print(\"Receiver:\", parcel[\"receiver\"])\n",
        "        print(\"Source:\", parcel[\"source\"])\n",
        "        print(\"Destination:\", parcel[\"destination\"])\n",
        "        print(\"Status:\", parcel[\"status\"])\n",
        "\n",
        "    else:\n",
        "        print(\"Invalid Tracking ID!\")\n",
        "\n",
        "\n",
        "def update_status():\n",
        "    tracking_id = input(\"Enter Tracking ID: \")\n",
        "\n",
        "    if tracking_id in parcels:\n",
        "        print(\"\\n1. Booked\")\n",
        "        print(\"2. In Transit\")\n",
        "        print(\"3. Out for Delivery\")\n",
        "        print(\"4. Delivered\")\n",
        "\n",
        "        choice = input(\"Select new status: \")\n",
        "\n",
        "        statuses = {\n",
        "            \"1\": \"Booked\",\n",
        "            \"2\": \"In Transit\",\n",
        "            \"3\": \"Out for Delivery\",\n",
        "            \"4\": \"Delivered\"\n",
        "        }\n",
        "\n",
        "        if choice in statuses:\n",
        "            parcels[tracking_id][\"status\"] = statuses[choice]\n",
        "            save_parcels()\n",
        "            print(\"Parcel status updated successfully!\")\n",
        "        else:\n",
        "            print(\"Invalid status choice!\")\n",
        "\n",
        "    else:\n",
        "        print(\"Tracking ID not found!\")\n",
        "\n",
        "\n",
        "def view_all_parcels():\n",
        "    print(\"\\n----- ALL PARCELS -----\")\n",
        "\n",
        "    if not parcels:\n",
        "        print(\"No parcel records found.\")\n",
        "        return\n",
        "\n",
        "    for tracking_id, parcel in parcels.items():\n",
        "        print(\"\\nTracking ID:\", tracking_id)\n",
        "        print(\"Receiver:\", parcel[\"receiver\"])\n",
        "        print(\"Destination:\", parcel[\"destination\"])\n",
        "        print(\"Status:\", parcel[\"status\"])\n",
        "\n",
        "\n",
        "parcels = load_parcels()\n",
        "\n",
        "while True:\n",
        "    print(\"\\n===== COURIER MANAGEMENT SYSTEM =====\")\n",
        "    print(\"1. Book Parcel\")\n",
        "    print(\"2. Track Parcel\")\n",
        "    print(\"3. Update Parcel Status\")\n",
        "    print(\"4. View All Parcels\")\n",
        "    print(\"5. Exit\")\n",
        "\n",
        "    choice = input(\"Enter your choice: \")\n",
        "\n",
        "    if choice == \"1\":\n",
        "        book_parcel()\n",
        "\n",
        "    elif choice == \"2\":\n",
